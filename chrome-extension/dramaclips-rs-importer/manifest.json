{
  "manifest_version": 3,
  "name": "DramaClips RS Importer",
  "version": "1.2.0",
  "description": "Imports RS Boost drama assets and connects a signed-in Instagram account to the private DramaClips admin.",
  "permissions": ["tabs", "storage", "cookies"],
  "host_permissions": [
    "https://cps.reelshort.com/resource-square/detail/*",
    "https://dramaclips.vercel.app/admin/*",
    "http://localhost:3000/admin/*",
    "http://localhost:3001/admin/*",
    "https://instagram.com/*",
    "https://*.instagram.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://dramaclips.vercel.app/admin/*", "http://localhost:3000/admin/*", "http://localhost:3001/admin/*"],
      "js": ["dramaclips-content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://cps.reelshort.com/resource-square/detail/*"],
      "js": ["rs-content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "DramaClips RS Importer" }
}
